{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "bun-types"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "mabl-verification/tools/**/*.ts",
    "mabl-verification/tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    ".aidlc"
  ]
}
